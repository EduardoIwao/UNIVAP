Algoritmo "Exercicio5"
// Aluno: Eduardo Iwao Garcia Reis Kunihiro
// Turma: 2UNB
// RA: 02610280
Var
n1: inteiro
Inicio
escreval("|=|========|=|PROGRAMA INICIALIZADO|=|========|=|")
escreval("Informe o numero:")
leia(n1)
escreval("|=|========|=|RESULTADO|=|========|=|")
se n1%2 = 0 entao
     escreval(" Número PAR")
senao
     escreval("Número ÍMPAR")
fimse
Fimalgoritmo